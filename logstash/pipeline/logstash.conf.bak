# ─────────────────────────────────────────────────────────────────────────────
# Logstash Pipeline
# ─────────────────────────────────────────────────────────────────────────────
#
# Routing strategy:
#   • Input  → Beats port (5044) from Filebeat
#              TCP  port (5000) from Python direct-TCP handler
#              HTTP port (8080) from services that POST logs
#
#   • Filter → Parse, enrich, normalise
#
#   • Output → Elasticsearch index pattern:
#              logs-<environment>-<product>-<service>-<YYYY.MM.dd>
#
# ─────────────────────────────────────────────────────────────────────────────

input {

  # From Filebeat
  beats {
    host  => "0.0.0.0"
    port => 5044
    client_inactivity_timeout => 60
  }


}

# ─────────────────────────────────────────────────────────────────────────────
filter {

  # ── 1. Parse timestamp ────────────────────────────────────────────────────
  #if [timestamp] {
  #  date {
  #    match   => ["timestamp",
  #                "ISO8601",
  #                "yyyy-MM-dd HH:mm:ss",
  #                "yyyy-MM-dd'T'HH:mm:ss.SSSZ"]
  #    target  => "@timestamp"
  #    remove_field => ["timestamp"]
  #  }
  #}


    # Parse JSON string from message
  json {
    source => "message"
    target => "parsed"
    skip_on_invalid_json => true
  }

  # Move parsed fields to root
  if [parsed] {
    mutate {
      rename => { "[parsed][timestamp]" => "timestamp" }
      rename => { "[parsed][level]" => "level" }
      rename => { "[parsed][environment]" => "environment" }
      rename => { "[parsed][product]" => "product" }
      rename => { "[parsed][service]" => "service" }
      rename => { "[parsed][message]" => "message" }
      rename => { "[parsed][trace_id]" => "trace_id" }
      rename => { "[parsed][extra]" => "extra" }
    }
  }

  # ── 2. Normalise required fields & set defaults ───────────────────────────
  mutate {
    # Lowercase environment and product for consistent index naming
    lowercase => ["environment", "product", "service"]

    # Rename 'msg' → 'message' (some Python loggers use 'msg')
    # rename    => { "msg" => "message" }
   rename => { "[event][message]" => "message" }
   rename => { "[event][level]" => "level" }
   rename => { "[event][timestamp]" => "timestamp" }

    # Default values when fields are missing
    replace   => {
      "environment" => "%{[environment]}"
      "product"     => "%{[product]}"
      "service"     => "%{[service]}"
    }
  }

  if ![environment] { mutate { add_field => { "environment" => "unknown" } } }
  if ![product]     { mutate { add_field => { "product"     => "unknown" } } }
  if ![service]     { mutate { add_field => { "service"     => "unknown" } } }

  # ── 3. Normalise log level ────────────────────────────────────────────────
  mutate {
    #uppercase => ["level"]
    #uppercase => ["[event][level]"]
    #rename => { "[event][msg]" => "message" }
    rename => { "[host]" => "[host_meta]" }

  }

  if ![level] {
    mutate { add_field => { "level" => "INFO" } }
  }

  # Map common aliases
  translate {
    field         => "level"
    destination   => "level"
    override      => true
    dictionary    => {
      "WARN"      => "WARNING"
      "ERR"       => "ERROR"
      "CRITICAL"  => "CRITICAL"
      "FATAL"     => "CRITICAL"
      "TRACE"     => "DEBUG"
      "VERBOSE"   => "DEBUG"
    }
    fallback      => "%{level}"
  }

  # ── 4. Add numeric severity (for sorting / alerting) ─────────────────────
  translate {
    field       => "level"
    destination => "severity"
    override    => true
    dictionary  => {
      "DEBUG"    => "10"
      "INFO"     => "20"
      "WARNING"  => "30"
      "ERROR"    => "40"
      "CRITICAL" => "50"
    }
    fallback => "0"
  }

  mutate { convert => { "severity" => "integer" } }

  # ── 5. Parse extra / context JSON blob if still a string ─────────────────
  #if [extra] and [extra] =~ /^\{/ {
  #  json {
  #    source      => "extra"
  #    target      => "extra"
  #    skip_on_invalid_json => true
  #  }
  #}

  # ── 6. GeoIP enrichment for ip / client_ip fields ─────────────────────────
  if [extra][client_ip] {
    geoip {
      source => "[extra][client_ip]"
      target => "[geoip]"
    }
  }

  # ── 7. Fingerprint for deduplication ──────────────────────────────────────
  fingerprint {
    source => ["@timestamp", "message"]
    #target         => "[@metadata][fingerprint]"
    #method         => "SHA256"
    #concatenate_sources => true
  }

  # ── 8. Tag error events for alerting ──────────────────────────────────────
  if [level] in ["ERROR", "CRITICAL"] {
    mutate { add_tag => ["alert-candidate"] }
  }

  # ── 9. Clean up internal / noisy fields ───────────────────────────────────
  mutate {
    remove_field => [
      "[agent][type]", "[agent][version]", "[agent][hostname]",
      "[log][offset]", "[input][type]",
      "[ecs][version]"
    ]
  }

}

# ─────────────────────────────────────────────────────────────────────────────
output {

  # ── Primary: Elasticsearch ───────────────────────────────────────────────
  elasticsearch {
    hosts    => ["http://elasticsearch:9200"]
    user     => "elastic"
    password => "${ELASTIC_PASSWORD}"

    # Index pattern: logs-<env>-<product>-<service>-YYYY.MM.dd
    index    => "logs-%{environment}-%{product}-%{service}-%{+YYYY.MM.dd}"

    # ILM (Index Lifecycle Management) – ties into the policy created by setup.sh
    ilm_enabled => false
    manage_template => false

    # Use fingerprint for document ID to allow safe re-indexing
    #document_id => "%{[@metadata][fingerprint]}"

    # Retry settings
    retry_max_interval => 64
    retry_initial_interval => 2

    # Pipeline (optional – set up in Elasticsearch for further enrichment)
    # pipeline => "logs-enrichment"
  }

  # ── Debug: stdout (disable in production) ───────────────────────────────
  stdout { codec => rubydebug }

}
